AURA_DB_HOST=
AURA_DB_NAME=
AURA_DB_USER=
AURA_DB_PASSWORD=
AURA_DB_PORT=

# Banco do portal de loggers: estoque / controle de entregas
AURA_POSTGRES_HOST=
AURA_POSTGRES_NAME=
